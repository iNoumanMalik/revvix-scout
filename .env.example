# Use a dedicated local database. Never point automated tests at shared or production data.
SCOUT_DATABASE_URL=postgresql+psycopg://localhost/revvix_scout
SCOUT_ENVIRONMENT=development
SCOUT_AUTH_MODE=development
# Required only when SCOUT_AUTH_MODE=supabase. Use a publishable key, never a secret/service key.
SCOUT_SUPABASE_URL=
SCOUT_SUPABASE_PUBLISHABLE_KEY=

